@{
    ViewData["Title"] = "Заказ оформлен";
}

<div class="container mt-5 text-center">

    <div class="card p-5">

        <h1 class="text-success mb-4">
            Заказ успешно оформлен!
        </h1>

        <h4 class="mb-4">
            Номер заказа:
            #@ViewBag.OrderId
        </h4>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">

            Вернуться на главную

        </a>

    </div>

</div>