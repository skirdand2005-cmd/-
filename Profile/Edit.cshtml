@model App.Models.User

@{
    ViewData["Title"] = "Редактирование профиля";
}

<h2 class="mb-4">Редактирование профиля</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label">Имя пользователя (логин)</label>
                        <input type="text" class="form-control bg-light" value="@Model.Username" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Полное имя</label>
                        <input asp-for="FullName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Телефон</label>
                        <input asp-for="Phone" type="tel" id="phoneInput" class="form-control" required />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Адрес доставки</label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                        <button type="submit" class="btn btn-success btn-lg px-4">Сохранить изменения</button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg px-4">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Форматирование телефона как при регистрации
    document.getElementById('phoneInput').addEventListener('input', function (e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 0) {
            if (!value.startsWith('7')) value = '7' + value;
            if (value.length > 11) value = value.substring(0, 11);
        }
        let formatted = '+7';
        if (value.length > 1) formatted += '-' + value.substring(1, 4);
        if (value.length > 4) formatted += '-' + value.substring(4, 7);
        if (value.length > 7) formatted += '-' + value.substring(7, 9);
        if (value.length > 9) formatted += '-' + value.substring(9, 11);
        e.target.value = formatted;
    });
</script>