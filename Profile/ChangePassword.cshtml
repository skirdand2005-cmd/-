@{
    ViewData["Title"] = "Смена пароля";
}

<h2 class="mb-4">Смена пароля</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="ChangePassword" method="post">
                    <div class="mb-3">
                        <label class="form-label">Текущий пароль</label>
                        <input type="password" name="currentPassword" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Новый пароль</label>
                        <input type="password" name="newPassword" class="form-control" required />
                        <small class="text-muted">Минимум 6 символов, включая буквы и цифры</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Подтвердите новый пароль</label>
                        <input type="password" name="confirmPassword" class="form-control" required />
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                        <button type="submit" class="btn btn-success btn-lg">Сменить пароль</button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>