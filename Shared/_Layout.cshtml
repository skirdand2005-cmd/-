
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CosmoShop</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <!-- NAVBAR -->
    <header>

        <nav class="navbar navbar-expand-lg navbar-custom">

            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    CosmoShop

                </a>

                <!-- MOBILE BUTTON -->
                <button class="navbar-toggler bg-white"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- NAVBAR -->
                <div class="collapse navbar-collapse"
                     id="navbarNav">

                    <div class="d-flex align-items-center gap-3 ms-auto flex-wrap navbar-actions">

                        <!-- CATALOG -->
                        <a asp-controller="Product"
                           asp-action="Index"
                           class="btn btn-catalog d-flex align-items-center gap-2">

                            ☰ Каталог

                        </a>

                        <!-- SEARCH -->
                        <form asp-controller="Product"
                              asp-action="Index"
                              method="get"
                              class="navbar-search-form">

                            <div class="navbar-search-wrapper">

                                <input type="text"
                                       name="search"
                                       class="navbar-search-input"
                                       placeholder="Поиск товаров..."
                                       value="@ViewBag.Search" />

                                <button type="submit"
                                        class="navbar-search-btn">

                                    🔍

                                </button>

                            </div>

                        </form>

                        <!-- CART -->
                        <a asp-controller="Cart"
                           asp-action="Index"
                           class="btn navbar-btn position-relative d-flex align-items-center gap-2">

                            🛒 Корзина

                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  id="cart-count">

                                0

                            </span>

                        </a>

                        <!-- AUTH -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">

                                <a class="btn navbar-btn dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    👤 @User.Identity.Name

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Profile"
                                           asp-action="Index">

                                            Личный кабинет

                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Account"
                                           asp-action="Logout">

                                            Выйти

                                        </a>
                                    </li>

                                </ul>

                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn navbar-btn">

                                Войти

                            </a>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn navbar-btn">

                                Регистрация

                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <!-- CONTENT -->
    <main class="main-content">

        @RenderBody()

    </main>

    <!-- FOOTER -->
    <footer class="footer">

        <div class="container text-center">

            © 2026 CosmoShop —
            Магазин премиальной косметики

        </div>

    </footer>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        async function updateCartCount() {

            try {

                const response =
                    await fetch('/Cart/GetCount');

                if (response.ok) {

                    const count =
                        await response.text();

                    document.getElementById('cart-count')
                        .textContent = count || '0';
                }

            } catch {

                document.getElementById('cart-count')
                    .textContent = '0';
            }
        }

        window.onload = updateCartCount;

    </script>

</body>
</html>