@model App.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name"
                 class="img-fluid rounded shadow-sm"
                 style="max-height: 500px; object-fit: contain; width: 100%;">
        }
        else
        {
            <div class="bg-light rounded" style="height: 400px; display: flex; align-items: center; justify-content: center;">
                <h4 class="text-muted">Нет изображения</h4>
            </div>
        }
    </div>

    <div class="col-md-6">
        <h2>@Model.Name</h2>
        <p class="text-muted fs-5">@Model.Brand?.Name</p>

        <h3 class="text-success mb-3">@Model.Price.ToString("0 ₽")</h3>

        @if (Model.Discount > 0)
        {
            <p class="text-danger">Скидка: @Model.Discount %</p>
        }

        <p><strong>Категория:</strong> @Model.Category?.Name</p>
        <p><strong>Артикул:</strong> @Model.Article</p>
        <p><strong>В наличии:</strong> @Model.Stock шт.</p>

        <div class="mt-4">
            <button onclick="addToCart(@Model.Id)" class="btn btn-primary btn-lg px-5">
                Добавить в корзину
            </button>
        </div>

        <hr class="my-4">

        <h5>Описание</h5>
        <p style="white-space: pre-line;">@Model.Description</p>
    </div>
</div>

<div class="mt-5">
    <a asp-action="Index" class="btn btn-secondary">← Вернуться в каталог</a>
</div>